# Copy this file to .env.local and fill in your own values. .env.local is git-ignored: never commit keys.
# All services below are free. The hackathon rules allow free APIs only.

# --- AI (Groq free tier) · https://console.groq.com/keys
GROQ_API_KEY=

# Model per agent (confirm current IDs at https://console.groq.com/docs/models). Limits are per model, so spreading agents multiplies the free quota.
MODEL_PLANNER=llama-3.3-70b-versatile
MODEL_READER=openai/gpt-oss-20b
MODEL_SCRIBE=openai/gpt-oss-120b
MODEL_SKEPTIC=qwen/qwen3-32b
MODEL_COACH=llama-3.1-8b-instant

# Optional backup provider if Groq is rate-limited: none | gemini | openrouter
LLM_FALLBACK=none
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Scholarly registries
# OpenAlex requires a free key since Feb 2026 · https://openalex.org (sign in → API key)
OPENALEX_API_KEY=
# Crossref "polite pool": put a team contact email here (no key needed)
CROSSREF_MAILTO=
# Unpaywall needs an email parameter
UNPAYWALL_EMAIL=
# Optional · https://www.semanticscholar.org/product/api
S2_API_KEY=

# --- App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
