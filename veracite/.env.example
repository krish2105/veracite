# Copy this file to .env.local and fill in your own values. .env.local is git-ignored: never commit keys.
# All services below are free. The hackathon rules allow free APIs only.

# --- AI (Groq free tier) · https://console.groq.com/keys
GROQ_API_KEY=

# Model per agent. Leave blank to use the defaults in src/lib/llm/models.ts (docs/11 §6).
# Llama left Groq's free tier in Aug 2026; free chat models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b (preview).
# Limits are per model, so spreading agents multiplies the free quota. "primary,fallback" also works.
MODEL_PLANNER=
MODEL_READER=
MODEL_SCRIBE=
MODEL_SKEPTIC=
MODEL_COACH=

# "rules" turns every AI call off (Rules mode: all checks still run). Leave blank for normal use.
AI_MODE=
# AI budget caps (per server instance; Groq's own limits are the hard backstop)
BUDGET_CALLS_PER_DAY=600
BUDGET_TOKENS_PER_DAY=400000
BUDGET_CALLS_PER_SESSION=12


# --- Scholarly registries
# OpenAlex requires a free key since Feb 2026 · https://openalex.org (sign in → API key)
OPENALEX_API_KEY=
# Crossref "polite pool": put a team contact email here (no key needed)
CROSSREF_MAILTO=
# Unpaywall needs an email parameter
UNPAYWALL_EMAIL=
# Optional · https://www.semanticscholar.org/product/api
S2_API_KEY=

# --- App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Feature flag overrides (see src/lib/flags.ts): comma list, "-name" turns one off. Baked in at build time, so redeploy after changing.
NEXT_PUBLIC_FLAGS=
